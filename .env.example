# Banco de Dados PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=chatbots2
DB_PASSWORD=your_password_here
DB_PORT=5432

# Chaves de Criptografia e Segurança
ENCRYPTION_KEY=your_encryption_key_here
DATABASE_ENCRYPTION_KEY=your_database_encryption_key_here
PAYLOAD_ENCRYPTION_KEY=your_payload_encryption_key_here
VITE_ENCRYPTION_KEY=your_vite_encryption_key_here
JWT_SECRET=your_jwt_secret_here

# Meta (WhatsApp Cloud / Instagram)
META_VERIFY_TOKEN=your_verify_token_here
META_APP_SECRET=your_meta_app_secret_here

# Configurações de Deploy VPS (Opcional)
VPS_HOST=your_vps_ip
VPS_PORT=22
VPS_USER=root
VPS_SSH_PASSWORD=your_vps_ssh_password
